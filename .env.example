# GRDF customer portal credentials (https://monespace.grdf.fr)
GRDF_USERNAME=prenom.nom@example.com
GRDF_PASSWORD=motdepasse
# Optional: PCE number (defaults to the account's first one)
# GRDF_PCE=12345678901234

# Optional: Tado home id (defaults to the account's first home)
# TADO_HOME_ID=123456
# Optional: initial Tado refresh token (otherwise an authorization link is logged)
# TADO_REFRESH_TOKEN=

# Schedule (cron format) and time zone
CRON=0 10 * * *
TZ=Europe/Paris
# Days of GRDF history fetched on every sync
LOOKBACK_DAYS=30
RUN_ON_START=true
DRY_RUN=false
LOG_LEVEL=info

# Identifiants de l'espace client GRDF (https://monespace.grdf.fr)
GRDF_USERNAME=prenom.nom@example.com
GRDF_PASSWORD=motdepasse
# Optionnel : numéro de PCE (sinon le premier du compte)
# GRDF_PCE=12345678901234

# Optionnel : identifiant du logement Tado (sinon le premier du compte)
# TADO_HOME_ID=123456
# Optionnel : refresh token Tado initial (sinon un lien d'autorisation est affiché dans les logs)
# TADO_REFRESH_TOKEN=

# Planification (format cron) et fuseau horaire
CRON=0 10 * * *
TZ=Europe/Paris
# Jours d'historique GRDF relus à chaque synchronisation
LOOKBACK_DAYS=30
RUN_ON_START=true
DRY_RUN=false
LOG_LEVEL=info

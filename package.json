{
  "name": "tado-sync",
  "version": "0.0.0-development",
  "private": true,
  "description": "Syncs GRDF gas meter readings to Tado Energy IQ",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pierrickrouxel/tado-sync.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "sync": "node dist/index.js --once"
  },
  "dependencies": {
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
